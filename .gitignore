# ==============================================================================
# IncidentIQ — Comprehensive Git Ignore Specification
# Covers: Python (FastAPI), Node (Vite/React), SQLite, IDEs, and OS artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (Crucial: Never commit credentials or local configs)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
secrets/

# ------------------------------------------------------------------------------
# 2. Database, Journals & Runtime Storage
# ------------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
incidentiq.db*
backend/incidentiq.db*
backend/data/
uploads/
storage/
temp/
tmp/

# ------------------------------------------------------------------------------
# 3. Python Runtime, Bytecode & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
env*/
venv*/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Test & Coverage Caches
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
# 4. Node.js, Frontend Build Artifacts & Vite Caches
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
.vite/
**/.vite/
.eslintcache
*.tsbuildinfo
package-lock.json.bak

# Node Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Application & Execution Logs (Allowing sample test data)
# ------------------------------------------------------------------------------
*.log
logs/
!sample_data/**

# Temporary, Backup & Swap Files
*.tmp
*.temp
*.bak
*.backup
*.old
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 6. Operating System Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 7. IDE & Code Editor Artifacts
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
